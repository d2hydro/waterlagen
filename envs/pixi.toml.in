# Generated from the release tag and the repository's runtime dependencies.
[workspace]
name = "waterlagen-productie"
version = "@VERSION@"
channels = ["conda-forge"]
platforms = @PLATFORMS@

[dependencies]
@DEPENDENCIES@

[pypi-dependencies]
waterlagen = "==@VERSION@"

[tasks]
controleer = 'python -c "from waterlagen._environment import main; main()"'
afwateringseenheden = "python ./scripts/afwateringseenheden.py"
autos = "python ./scripts/autos.py"
dem = "python ./scripts/dem.py"
functioneel_landgebruik = "python ./scripts/functioneel_landgebruik.py"
inwoners = "python ./scripts/inwoners.py"
